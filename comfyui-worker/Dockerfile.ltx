# GLTCH — ComfyUI RunPod Serverless Worker (LTX-2.3 — Audio/Video)
# Dedicated worker for the LTX-2.3 All-In-One workflow:
#   Text / Image / First-Last-Frame / Video / Audio → Video (with native audio + lip-sync).
# Kept SEPARATE from the WAN 2.2 worker so a ComfyUI core update can't break production.
#
# Build context is the REPO ROOT (RunPod GitHub deploy uses repo root), so COPY
# paths are prefixed with comfyui-worker/. Build from the repo root:
#   docker build -f comfyui-worker/Dockerfile.ltx -t your-dockerhub-user/comfyui-ltx:latest .
#   docker push your-dockerhub-user/comfyui-ltx:latest
#
# Models live on the shared RunPod network volume at:
#   /runpod-volume/runpod-slim/ComfyUI/models/{diffusion_models,text_encoders,vae,loras,latent_upscale_models}

FROM runpod/worker-comfyui:5.7.1-base

# ── Update ComfyUI core to latest (LTX-2.3 native support) ───────
# LTX-2.3 needs recent core: comfy/ldm/lightricks, the ltxv DualCLIPLoader type,
# and the built-in LatentUpscaleModelLoader. Same pattern as Dockerfile.zimage.
# Bump COMFYUI_PULLED to force a fresh core. Docker caches the RUN below, so
# a rebuild that changes nothing above it silently reuses whatever ComfyUI
# version was baked in — the build succeeds and the core is unchanged. That is
# how a worker ends up not knowing LTX-2.3
# despite having "just been rebuilt".
ARG COMFYUI_PULLED=2026-09-04
RUN echo "comfyui pulled $COMFYUI_PULLED" && \
    cd /comfyui && git fetch origin master && git reset --hard origin/master && \
    git log -1 --format="ComfyUI core now at %h %ad" --date=short && \
    uv pip install -r requirements.txt

# ── Custom Nodes (git clone → uv pip install into /opt/venv) ─────
# All custom nodes are pinned to exact commits (verified working 2026-11-03).
# Unpinned clones broke prod on 2026-11-01 (KJNodes). Bump a pin on purpose, then test.
# Base image uses a Python venv at /opt/venv via uv. All installs use `uv pip install`.

WORKDIR /comfyui/custom_nodes

# ComfyUI-GGUF (UnetLoaderGGUF — loads ltx-2-3-22b-dev-Q4_K_M.gguf)
RUN git clone https://github.com/city96/ComfyUI-GGUF.git && git -C ComfyUI-GGUF checkout -q 6ea2651e7df6 && \
    cd ComfyUI-GGUF && \
    uv pip install -r requirements.txt

# VideoHelperSuite (VHS_LoadVideo, VHS_VideoCombine — video I/O)
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && git -C ComfyUI-VideoHelperSuite checkout -q 4d907bee61e9 && \
    cd ComfyUI-VideoHelperSuite && \
    uv pip install -r requirements.txt

# KJNodes (VAELoaderKJ, GetNode, SetNode)
# Pinned: ab72eda (2026-10-29, ImageCompareKJ) needs io.Autogrow, which ComfyUI 0.6.0
# lacks; the whole pack then fails to import (ImageResizeKJv2 "does not exist").
RUN git clone https://github.com/kijai/ComfyUI-KJNodes.git && \
    cd ComfyUI-KJNodes && \
    git checkout b5316a9 && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# LTXVideo (LTXVChunkFeedForward, LTXV loaders/samplers)
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git && git -C ComfyUI-LTXVideo checkout -q 220e1d45aa04 && \
    cd ComfyUI-LTXVideo && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# rgthree (Power Lora Loader)
RUN git clone https://github.com/rgthree/rgthree-comfy.git && git -C rgthree-comfy checkout -q bc48c6aaeca8 && \
    cd rgthree-comfy && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# cg-use-everywhere (Anything Everywhere, Combo Clone)
RUN git clone https://github.com/chrisgoringe/cg-use-everywhere.git && git -C cg-use-everywhere checkout -q ffc99037eea8 && \
    cd cg-use-everywhere && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# mxToolkit (mxSlider)
RUN git clone https://github.com/Smirnov75/ComfyUI-mxToolkit.git && git -C ComfyUI-mxToolkit checkout -q 7f7a0e584f12 && \
    cd ComfyUI-mxToolkit && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# comfyui-various (JWInteger, JWIntegerToFloat)
RUN git clone https://github.com/jamesWalker55/comfyui-various.git && git -C comfyui-various checkout -q ddf36c68c5fd && \
    cd comfyui-various && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# Custom_Switch (OrchestratorNodeMuter — auto-mute switching between modes)
RUN git clone https://github.com/tritant/ComfyUI_Custom_Switch.git && git -C ComfyUI_Custom_Switch checkout -q 08d2b3a08e65 && \
    cd ComfyUI_Custom_Switch && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

# Image-Saver (Sampler Selector)
RUN git clone https://github.com/alexopus/ComfyUI-Image-Saver.git && git -C ComfyUI-Image-Saver checkout -q dbf94571699d && \
    cd ComfyUI-Image-Saver && \
    ([ -f requirements.txt ] && uv pip install -r requirements.txt || true)

WORKDIR /

# ── Extra Python deps (GGUF support) ─────────────────────────────
RUN uv pip install gguf

# ── Verify critical nodes exist at build time ────────────────────
RUN python -c "import os; \
    assert os.path.isfile('/comfyui/custom_nodes/ComfyUI-LTXVideo/__init__.py'), 'LTXVideo missing'; \
    assert os.path.isfile('/comfyui/custom_nodes/ComfyUI-GGUF/__init__.py'), 'GGUF missing'; \
    assert os.path.isfile('/comfyui/custom_nodes/ComfyUI-VideoHelperSuite/__init__.py'), 'VHS missing'; \
    assert os.path.isfile('/comfyui/custom_nodes/ComfyUI-KJNodes/__init__.py'), 'KJNodes missing'; \
    assert os.path.isdir('/comfyui/comfy/ldm/lightricks'), 'LTX core (comfy/ldm/lightricks) missing — core too old'; \
    print('LTX worker: critical nodes + LTX core verified OK')"

# ── Entrypoint ───────────────────────────────────────────────────
# entrypoint.sh symlinks model dirs + custom nodes from the network volume,
# and patches handler.py to merge gifs/videos into the images output list.
COPY comfyui-worker/entrypoint.sh /entrypoint.sh
# Vast.ai overflow mode (unused on RunPod): vast_start.sh is only run when
# the scaler in api/_lib/vast.ts rents this image on Vast.
COPY comfyui-worker/vast_agent.py /vast_agent.py
COPY comfyui-worker/vast_start.sh /vast_start.sh
RUN chmod +x /vast_start.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/start.sh"]

# ── Network Volume Model Paths ───────────────────────────────────
# Adds latent_upscale_models (spatial upscaler) + text_encoders key for LTX-2.3.
RUN printf "\nrunpod_volume:\n    base_path: /runpod-volume/runpod-slim/ComfyUI/models\n    checkpoints: checkpoints\n    upscale_models: upscale_models\n    latent_upscale_models: latent_upscale_models\n    vae: vae\n    clip: text_encoders\n    text_encoders: text_encoders\n    clip_vision: clip_vision\n    loras: loras\n    unet: unet\n    diffusion_models: diffusion_models\n\nrunpod_volume_unet_compat:\n    base_path: /runpod-volume/runpod-slim/ComfyUI/models\n    diffusion_models: unet\n" >> /comfyui/extra_model_paths.yaml

# ── Patch handler.py to support image output ─────────────────────
COPY comfyui-worker/handler_patch.py /handler_patch.py
RUN python /handler_patch.py && rm /handler_patch.py

# ── Patch rp_upload.py to read BUCKET_NAME from env ─────────────
COPY comfyui-worker/bucket_patch.py /bucket_patch.py
RUN python /bucket_patch.py && rm /bucket_patch.py

# ── Patch handler.py to clean up after each job ─────────────────
COPY comfyui-worker/cleanup_patch.py /cleanup_patch.py
RUN python /cleanup_patch.py && rm /cleanup_patch.py

# ── Patch VideoHelperSuite: move LTX native-audio waveform to CPU before muxing
#    (fixes "can't convert cuda:0 tensor to numpy" in VHS_VideoCombine) ──
COPY comfyui-worker/audio_cpu_patch.py /audio_cpu_patch.py
RUN python /audio_cpu_patch.py && rm /audio_cpu_patch.py
