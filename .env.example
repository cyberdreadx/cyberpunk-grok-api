# ── Frontend (Vite) ──────────────────────────────────────────────
# Supabase project credentials (public — safe for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase Edge Functions (server-side secrets) ────────────────
# Your xAI API key (used by proxy-generate to call xAI on behalf of credit users)
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — one-time packs (create as one-time payment products)
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MEGA=price_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — monthly subscriptions (create as recurring monthly products)
STRIPE_PRICE_SUB_BASIC=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_PREMIUM=price_xxxxxxxxxxxxxxxxxxxxx

# Frontend URL for Stripe redirect
SITE_URL=https://yourapp.com
