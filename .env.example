# ── Vercel Environment Variables ─────────────────────────────────

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret for auth (generate a random 64-char string)
JWT_SECRET=your-random-64-character-secret-here

# xAI API key (used by /api/generate to call xAI on behalf of credit users)
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx

# fal.ai API key (powers the SEEDANCE 2.0 video engine — text-to-video & image-to-video)
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=fal-xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — one-time packs
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MEGA=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ULTRA=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price ID — LoRA unlock (one-time $30 payment)
STRIPE_PRICE_LORA_UNLOCK=price_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — monthly subscriptions (v3 ladder: CASUAL/REGULAR/HOBBYIST/POWER USER @ $9/$19/$39/$79)
# Generate all 8 subs with: bunx tsx scripts/setup-stripe-sub-prices-v3.ts --live
# Or: bash scripts/setup-stripe-products-v3.sh --live
STRIPE_PRICE_SUB_BASIC=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_PREMIUM=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_ELITE=price_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — yearly subscriptions (12% off vs monthly × 12)
STRIPE_PRICE_SUB_BASIC_YEARLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_PREMIUM_YEARLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUB_ELITE_YEARLY=price_xxxxxxxxxxxxxxxxxxxxx

# Grandfathered subscription price IDs (customers still billed on old Stripe prices).
# STRIPE_LEGACY_PRICE_MAP maps old price_ IDs → tier names so they still get the right discount.
# Example: STRIPE_LEGACY_PRICE_MAP={"price_OLD_PRO":"pro","price_OLD_ELITE":"elite"}
# STRIPE_LEGACY_PRICE_CREDITS overrides exact monthly credits per old price ID (optional).
# Example: STRIPE_LEGACY_PRICE_CREDITS={"price_OLD_BASIC":150,"price_OLD_PREMIUM":500}
# LEGACY_CREDITS_PER_DOLLAR=13  # fallback when no override / no credits_per_month metadata

# Resend API key for email verification (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Email sender address (must be verified in Resend)
EMAIL_FROM=verify@yourdomain.com

# Frontend URL for Stripe redirect
SITE_URL=https://yourapp.vercel.app

# ── Optional: ComfyUI (admin-only image gen) ──
# Choose ONE backend: RunPod Serverless (recommended) OR local ComfyUI.
#
# Option A — RunPod Serverless (cloud GPU, auto-scales):
# RUNPOD_ENDPOINT_ID=your-endpoint-id       # fallback endpoint (required)
# RUNPOD_WAN_ENDPOINT_ID=your-wan-endpoint  # WAN video endpoint (H200; keeps video models warm)
# RUNPOD_QWEN_EDIT_ENDPOINT_ID=your-klein-endpoint # Image workflows: klein (Flux 2 Klein edit) + zimage (H200 or 4090)
# RUNPOD_API_KEY=your-runpod-api-key       # from RunPod settings
# COMFYUI_MODELS=model1.safetensors,model2.safetensors  # models baked into Docker image
# COMFYUI_VIDEO_LORAS=file1_high.safetensors,file1_low.safetensors,file2.safetensors  # comma-separated, auto-pairs high/low variants
#
# Option B — Local ComfyUI (via Tailscale Funnel or ngrok):
# COMFYUI_URL=https://your-machine.tail1234.ts.net

# ── Optional: GLTCH Edit (public Qwen Edit feature) ──
# Uses RunPod's public Qwen Edit endpoint. Falls back to RUNPOD_ENDPOINT_ID if not set.
# GLTCH_ENDPOINT_ID=qwen-image-edit-2511-lora  # RunPod public endpoint slug

# ── Media storage (REQUIRED for production — avoids $400+/mo Vercel Blob egress) ──
# New uploads go to Cloudflare R2 (free egress). Legacy Blob URLs still work for old posts.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=grokker-media
# R2_PUBLIC_BUCKET_URL=https://pub-xxxxx.r2.dev   # REQUIRED — enable "Public Development URL" on the bucket (no custom domain needed)
# R2_PUBLIC_DOMAIN=                                 # optional — skip unless you later attach a custom domain

# Legacy Vercel Blob (fallback only if R2 not set — expensive at scale)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# ── Content Safety (private blocklist) ──
# Base64-encoded JSON with blocked term patterns. Never commit the actual terms.
# Format: { "minor_terms": [...], "explicit_terms": [...], "absolute_blocks": [...] }
# Generate with: node -e "console.log(Buffer.from(JSON.stringify({minor_terms:[],explicit_terms:[],absolute_blocks:[]})).toString('base64'))"
# SAFETY_BLOCKLIST=base64encodedstring

# ── Optional: XRGE Token Payment (ERC-20 on Base) ──
# Enables $XRGE as a payment method with 15% bonus credits.
# Price is fetched live from DexScreener (Aerodrome pair on Base).
# XRGE_DEPOSIT_ADDRESS=0xYourBaseWalletAddress   # Treasury wallet that receives XRGE
# XRGE_USD_RATE=0.00002                          # (Optional) Override live price with a fixed rate
# BASE_RPC_URL=https://mainnet.base.org          # Base chain RPC (default works, or use Alchemy/Infura)

# ── Optional: Character Chat Mode (AI Companions) ──
# DeepSeek API key for cheap uncensored chat (https://platform.deepseek.com)
# Also powers @gltch in the public chat lobby when set (Lovable/Gemini fallback if unset).
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional override for lobby bot only (defaults to CHARACTER_CHAT_TEXT_MODEL_DS or deepseek-chat):
# CHAT_LOBBY_DEEPSEEK_MODEL=deepseek-chat

# ── Optional: Reddit Subreddit Reward ──
# Secret code that users enter to claim 10 free credits for joining r/GrokRunner.
# Post this code in the subreddit (pinned post, sidebar, wiki). Rotate anytime.
# REDDIT_REWARD_CODE=GROKRUNNER2026

# ── Optional: Frontend ──
# VITE_API_URL=https://yourapp.vercel.app/api (only if API is on a different domain)
# Local dev (`npm run dev`): without VITE_API_URL, requests go to /api — Vite proxies to Vercel (see vite.config).
# Override proxy target if needed:
# VITE_DEV_API_PROXY_TARGET=https://your-project.vercel.app
