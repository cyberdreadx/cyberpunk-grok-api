# ── Discord ──────────────────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
DISCORD_TOKEN=            # Bot → Token
DISCORD_CLIENT_ID=        # General Information → Application ID

# ── GltchRunner backend ──────────────────────────────────────────────────
DATABASE_URL=             # same Neon DB as the main app (reuses users/credits)
API_BASE=https://api.gltch.app/api

# JWT_SECRET MUST match the main app's .env so the bot can mint a short-lived
# token for a linked user and call the existing backend as that user.
JWT_SECRET=

# Web URL where users paste their /link code (see README → web-side verify)
SITE_URL=https://grokrunner.gltch.app
