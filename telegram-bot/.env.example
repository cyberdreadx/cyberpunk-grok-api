# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# Database (same Neon Postgres as the web app)
DATABASE_URL=postgresql://...

# RunPod
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-image-endpoint-id
RUNPOD_WAN_ENDPOINT_ID=your-video-endpoint-id

# XRGE payments
XRGE_DEPOSIT_ADDRESS=0x...
BASE_RPC_URL=https://mainnet.base.org

# Optional: override live XRGE price
# XRGE_USD_RATE=0.05

# Optional: ComfyUI model overrides
# COMFYUI_KLEIN_UNET=flux-2-klein-9b-nvfp4.safetensors
# COMFYUI_KLEIN_CLIP=qwen_3_8b_fp8mixed.safetensors
# COMFYUI_KLEIN_VAE=flux2-vae.safetensors
# COMFYUI_GLTCH_HIGH_MODEL=wan22EnhancedNSFWSVICamera_nsfwFASTMOVEV2Q8H.gguf
